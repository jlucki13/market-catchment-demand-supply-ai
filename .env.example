# Copy this file to `.env` (which is gitignored) and fill in what you have.
# Keys are read automatically -- no need to set them in your shell each session.
#
# You do not need all of these at once. Start with the two that are free and
# require no card, then add Google when you are ready. See docs/running-free.md.

# --- Free, no credit card ---------------------------------------------------

# https://account.mapbox.com/auth/signup/ -- your default public token, starts pk.
MAPBOX_ACCESS_TOKEN=

# https://api.census.gov/data/key_signup.html -- arrives by email, click to activate
CENSUS_API_KEY=

# --- Free tier, but requires a billing account on file -----------------------

# https://console.cloud.google.com/ -- enable Geocoding, Places API (New),
# Places Aggregate, and Routes. Set a budget alert before you use it.
GOOGLE_MAPS_API_KEY=

# --- No free tier; only needed without --no-llm ------------------------------

# https://console.anthropic.com/ -> Settings -> API Keys. Set a spend limit
# under Settings -> Limits before using it. Requires the reasoning extra:
#   pip install -e ".[reasoning]"
ANTHROPIC_API_KEY=
