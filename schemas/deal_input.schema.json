{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcds.local/schemas/deal_input.schema.json",
  "title": "Deal Input",
  "description": "One deal under evaluation. The only file a user writes by hand.",
  "type": "object",
  "required": ["deal_id", "address", "vertical"],
  "additionalProperties": false,
  "properties": {
    "deal_id":   { "type": "string", "minLength": 1 },
    "label":     { "type": "string" },
    "address":   { "type": "string", "minLength": 5 },
    "vertical":  { "type": "string", "description": "Must match a config/verticals/<id>.yaml" },
    "catchment_minutes": {
      "type": ["integer", "null"],
      "minimum": 1, "maximum": 60,
      "description": "Overrides the vertical default. Mapbox caps a contour at 60 minutes."
    },
    "asking_price":   { "type": ["number", "null"], "minimum": 0 },
    "reported_sde":   { "type": ["number", "null"] },
    "seller_claims":  { "$ref": "seller_claims.schema.json" },
    "notes":          { "type": "string" }
  }
}
